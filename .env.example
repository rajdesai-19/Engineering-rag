# Optional configuration for RAG Workflow. Copy to `.env` and edit.
# The default backend is a local GGUF model in models/, which needs no configuration.

# Google Gemini API key (optional; enables the "Google Gemini" backend).
# Note: with Gemini, retrieved excerpts and your questions are sent to Google.
# GEMINI_API_KEY=your_gemini_api_key_here

# Ollama host URL (optional; used only if the Ollama daemon is running)
OLLAMA_BASE_URL=http://localhost:11434
